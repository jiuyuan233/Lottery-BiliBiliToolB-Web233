# =============================================================================
# LotteryAutoScript 定时任务 —— 类人类作息
# -----------------------------------------------------------------------------
# 模拟一个「白天活跃、夜里睡觉」的真实用户行为节奏，降低被风控的概率：
#   * 08:33  起床后先看看有没有中奖          (check)
#   * 10:33  上午参与抽奖（timeout 20分钟≈26条）(start)
#   * 12:13  午休刷动态，参与一波抽奖        (start, timeout 20分钟≈26条)
#   * 19:33  晚饭后活跃高峰，再参与一波      (start, timeout 20分钟≈26条)
#   * 22:03  睡前检查中奖结果                (check)
#   * 周日 23:03  周末清理一下临时关注/动态   (clear)
# 0:00-8:00 不执行任何任务（睡眠期）。
# 三次 start 间隔均超过 1 小时，发够 26 条就休息，避免短时间大量转发。
# -----------------------------------------------------------------------------
# 格式：分 时 日 月 周  命令
# PATH 含 node 所在目录；run-task.sh 自动写日志 + 飞书推送（与 Actions 版一致）。
# start 命令用 timeout 1200s 限制运行时长（26条×45s≈20分钟），到时间自动停。
# =============================================================================
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
SHELL=/bin/sh

# 早 8:33 —— 起床检查中奖（错峰避整点）
33 8 * * * cd /app && ./run-task.sh check

# 上午 10:33 —— 参与抽奖（timeout 20分钟≈转发26条后自动停）
33 10 * * * cd /app && ./run-task.sh start 1200

# 午 12:13 —— 午休参与抽奖（timeout 20分钟≈转发26条后自动停）
13 12 * * * cd /app && ./run-task.sh start 1200

# 晚 19:33 —— 晚饭后活跃高峰参与抽奖（timeout 20分钟≈转发26条后自动停）
33 19 * * * cd /app && ./run-task.sh start 1200

# 晚 22:03 —— 睡前检查中奖（错峰）
3 22 * * * cd /app && ./run-task.sh check

# 周日 23:03 —— 周末清理临时关注与转发动态（错峰）
3 23 * * 0 cd /app && ./run-task.sh clear
