# =============================================================================
# 环境变量示例  ——  复制为 .env 后按需修改
# =============================================================================

# 对外统一访问端口（浏览器访问 http://服务器IP:22330）
WEB_PORT=22330

# BiliBiliToolPro 面板镜像标签，latest 跟随上游正式发布；改具体版本可锁版
BILITOOL_TAG=latest

# cookie 同步间隔（秒）。默认 300=5 分钟。
# bili_tool_web 刷新 cookie 后，最多等这个时间 lottery 就能拿到新 cookie。
SYNC_INTERVAL=300

# -----------------------------------------------------------------------------
# 说明：BiliBiliToolPro 面板初始账号 admin / BiliTool@2233，首次登录后请改密。
# 扫码登录在面板「登录」任务里完成，扫一次码即同时给两个服务用。
# -----------------------------------------------------------------------------
